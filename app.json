{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "backgroundImage": "./assets/branding/android-icon-background.png",
        "foregroundImage": "./assets/branding/android-icon-foreground.png",
        "monochromeImage": "./assets/branding/android-icon-monochrome.png"
      },
      "package": "io.github.beeman.pocketaddress",
      "predictiveBackGestureEnabled": false,
      "versionCode": 1
    },
    "backgroundColor": "#0B0D10",
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "icon": "./assets/branding/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "name": "Pocket Address",
    "orientation": "portrait",
    "plugins": [
      [
        "expo-dev-client",
        {
          "showMenuAtLaunch": false,
          "skipOnboarding": true
        }
      ],
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D10",
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "./plugins/with-arm64-only",
      "./plugins/with-release-signing"
    ],
    "scheme": "pocket-address",
    "slug": "pocket-address",
    "userInterfaceStyle": "dark",
    "version": "1.0.0",
    "web": {
      "favicon": "./assets/branding/favicon.png",
      "output": "static"
    }
  }
}
